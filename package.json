{
  "name": "flashnack",
  "version": "0.1.0",
  "private": true,
  "description": "Develop Flashback ONE35 RAW photos in your browser with film looks. A web port of LoFi Logic.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5291",
    "build": "vite build",
    "preview": "vite preview --port 5292",
    "luts": "node scripts/convert-luts.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "start": "vite build && vite preview --port 5292 --open"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@jsquash/jpeg": "1.6.0",
    "fflate": "0.8.2",
    "libraw-wasm": "1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "homepage": "https://gitguy268.github.io/flashnack/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gitguy268/flashnack.git"
  },
  "author": "Lucas Van De Weerd",
  "engines": {
    "node": ">=20"
  }
}
